# ============================================================
# EduLivre — Frontend Environment Variables (Vite)
# Copie para .env e preencha os valores
# ============================================================

# URL base da API backend (sem barra no final)
# Deixe em branco para usar modo offline (localStorage)
VITE_API_URL=http://localhost:3001/api

# Exemplo produção:
# VITE_API_URL=https://sua-api.railway.app/api
