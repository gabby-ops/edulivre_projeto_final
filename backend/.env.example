# ============================================================
# EduLivre — Backend Environment Variables
# Copie para .env e preencha os valores
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_string_aleatoria_longa_e_segura
JWT_EXPIRES_IN=7d

# ── Supabase ─────────────────────────────────────────────────
# Obtenha em: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # service_role key (NÃO o anon key)

# ── SMTP (E-mail) ─────────────────────────────────────────────
# Deixe em branco para usar o modo DEV (links no console)
# Gmail: use smtp.gmail.com + App Password
# Brevo / SendGrid / Mailgun também funcionam
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_app_password_aqui
SMTP_FROM=EduLivre <seuemail@gmail.com>
